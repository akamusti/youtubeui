{
  "manifest_version": 3,
  "name": "YüzeTube",
  "version": "1.5.0",
  "description": "YouTube deneyimini sadeleştiren, güvenli ve kişiselleştirilebilir arayüz.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "action": {
    "default_title": "YüzeTube ayarları",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/embed/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
